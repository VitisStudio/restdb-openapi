{
    "name": "vitisstudio/restdb-openapi",
    "description": "OpenAPI 3.0.3 model generator for the RestDB Eloquent driver",
    "license": "MIT",
    "keywords": ["laravel", "eloquent", "openapi", "oas", "rest", "driver"],
    "homepage": "https://github.com/VitisStudio/laravel-restdb-driver",
    "authors": [
        {
            "name": "Dan Poblete",
            "email": "dan@vitis.studio"
        }
    ],
    "support": {
        "issues": "https://github.com/VitisStudio/laravel-restdb-driver/issues",
        "source": "https://github.com/VitisStudio/laravel-restdb-driver"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "vitisstudio/restdb": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Vitis\\RestDB\\OpenApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vitis\\RestDB\\OpenApi\\OpenApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
